{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mariopeces/NivoSense/pipelines/catalog/schema.json",
  "title": "NivoSense catalogue",
  "description": "Entry objects (catalog/entries/<layer>/<date>.json) and the index (catalog/index.json). Paths are keys relative to the catalogue root, so the same entry is valid in staging and prod. Every number is finite: the objects are strict JSON (RFC 8259), which has no NaN or Infinity.",
  "oneOf": [{ "$ref": "#/$defs/entry" }, { "$ref": "#/$defs/index" }],
  "$defs": {
    "layer": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["observed", "gapfilled", "modelled", "forecast"] },
    "key": { "type": "string", "pattern": "^[a-z0-9_]+/[A-Za-z0-9_./-]+$" },
    "bounds": {
      "description": "West, south, east, north in WGS84 longitude and latitude.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "qa": {
      "type": "object",
      "properties": {
        "flags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "uniqueItems": true },
        "scores": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "required": ["flags", "scores"],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "layer": { "$ref": "#/$defs/layer" },
        "date": { "$ref": "#/$defs/date" },
        "status": { "$ref": "#/$defs/status" },
        "cog": { "$ref": "#/$defs/key" },
        "pmtiles": { "$ref": "#/$defs/key" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "crs": { "const": "EPSG:32630" },
        "resolution_m": { "enum": [10, 20, 100] },
        "bands": {
          "description": "One item per band of the COG, in band order.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "units": {
          "description": "One item per band; '1' for dimensionless values and class codes.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "value_range": {
          "description": "Declared [min, max] per band, checked against the pixels (nodata excluded) at publish time.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        },
        "nodata": {
          "description": "Finite sentinel value of the COG's nodata pixels (for example -9999 for float layers); NaN is refused at publish time because JSON cannot carry it.",
          "type": "number"
        },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "input_key": { "$ref": "#/$defs/sha256" },
        "pixel_hash": { "$ref": "#/$defs/sha256" },
        "code_version": { "type": "string", "minLength": 1 },
        "qa": { "$ref": "#/$defs/qa" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "layer", "date", "status", "cog", "pmtiles", "bounds", "crs", "resolution_m", "bands", "units",
        "value_range", "nodata", "source_ids", "input_key", "pixel_hash", "code_version", "qa", "created_at"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "properties": {
        "schema_version": { "const": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "entries_digest": {
          "description": "sha256 of the layers object; the index is rewritten only when it changes.",
          "$ref": "#/$defs/sha256"
        },
        "layers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/layer" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "dates": {
                "description": "Ascending; the same order as entries.",
                "type": "array",
                "items": { "$ref": "#/$defs/date" },
                "uniqueItems": true
              },
              "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
            },
            "required": ["dates", "entries"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schema_version", "generated_at", "entries_digest", "layers"],
      "additionalProperties": false
    }
  }
}
