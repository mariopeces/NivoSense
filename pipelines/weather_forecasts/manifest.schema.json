{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "region", "common_horizons_hours", "models"],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "region": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "bbox"],
          "properties": {
            "id": { "type": "string" },
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number" }
            }
          }
        }
      ]
    },
    "common_horizons_hours": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1,
      "uniqueItems": true
    },
    "unavailable_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "reason"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "name", "attribution", "run_at", "source", "grid_degrees", "horizons"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "attribution": { "type": "string" },
          "run_at": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "format": "uri" },
          "grid_degrees": { "type": "number", "exclusiveMinimum": 0 },
          "horizons": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["valid_at", "precipitation_total", "snowfall"]
            }
          }
        }
      }
    }
  }
}
