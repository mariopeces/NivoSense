# Direct dependencies of the Python pipelines. Edit this file, then regenerate both locks from pipelines/:
#   uv pip compile requirements.in --generate-hashes --python-version 3.11 \
#     --python-platform x86_64-manylinux_2_28 -o requirements.lock
#   uv pip compile requirements-dev.in --generate-hashes --python-version 3.11 \
#     --python-platform x86_64-manylinux_2_28 -o requirements-dev.lock
numpy==2.*
# The rasterio wheel bundles GDAL, so this pin also fixes GDAL (3.10.3 for rasterio 1.4.4).
rasterio==1.4.4
pillow==11.*
jsonschema==4.*
# WeatherNext 3: Zarr v3 statistics store read lazily from Google Cloud Storage.
xarray==2026.*
zarr==3.*
obstore==0.12.*
# PMTiles builder (`rio pmtiles`).
rio-pmtiles==1.2.2
# Catalogue writes to Google Cloud Storage with generation preconditions (ifGenerationMatch).
google-cloud-storage==3.17.*
# IANA time zones for zoneinfo (Europe/Madrid in the freshness SLO); Windows has no system database.
tzdata==2026.*
# PMTiles reader for the QA harness (header checks and thumbnails); already installed by rio-pmtiles.
pmtiles==3.8.*
# Domain build (pipelines/domain): read the REDIAM WFS GML and the MITECO shapefiles, reproject, union and intersect.
# The pyogrio wheel bundles its own GDAL, separate from rasterio's.
geopandas==1.2.0
pyogrio==0.13.0
pyproj==3.7.2
shapely==2.2.0
